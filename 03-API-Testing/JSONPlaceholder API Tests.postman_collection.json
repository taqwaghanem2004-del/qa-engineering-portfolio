    {
      "name": "GET Requests",
      "item": [
        {
          "name": "GET all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is a non-empty array\", function () {\r\n    const posts = pm.response.json();\r\n    pm.expect(posts).to.be.an(\"array\");\r\n    pm.expect(posts.length).to.be.above(0);\r\n});\r\n\r\npm.test(\"First post has the expected fields\", function () {\r\n    const first = pm.response.json()[0];\r\n    pm.expect(first).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET single post",
