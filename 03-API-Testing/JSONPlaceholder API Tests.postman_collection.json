    {
      "name": "POST Requests",
      "item": [
        {
          "name": "Create new post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Created post has an id and echoes the sent title\", function () {\r\n    const created = pm.response.json();\r\n    const sent = JSON.parse(pm.request.body.raw);\r\n    pm.expect(created).to.have.property(\"id\");\r\n    pm.expect(created.title).to.eql(sent.title);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "     {\r\n       \"title\": \"Testing with Postman\",\r\n       \"body\": \"Testing with Postman\",\r\n       \"userId\": 1\r\n     }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        }
      ]
