        {
          "name": "GET posts by user (query param)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"All posts belong to userId 1\", function () {\r\n    const responseJson = pm.response.json();\r\n    responseJson.forEach(post => {\r\n        pm.expect(post.userId).to.eql(1);\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
